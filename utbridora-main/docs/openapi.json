      "get": {
        "summary": "Lấy token CSRF theo session",
        "description": "Token chỉ giữ trong bộ nhớ. Lấy lại sau login/logout. Không ghi token vào log.",
        "operationId": "get_api_v1_auth_csrf",
        "security": [],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "headerName": {
                      "type": "string"
                    },
                    "token": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "headerName",
                    "token"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Payload hoặc điều kiện không hợp lệ"
          },
          "401": {
            "description": "Chưa xác thực hoặc phiên hết hiệu lực"
          },
          "403": {
            "description": "Thiếu quyền, scope hoặc CSRF"
          },
          "409": {
            "description": "Trùng dữ liệu hoặc xung đột đồng thời"
          }
        }
      }
    },

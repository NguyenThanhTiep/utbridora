{
  "openapi": "3.1.0",
  "info": {
    "title": "UTBridora T5 Demand implementation candidate",
    "version": "0.1.0-candidate",
    "description": "T5-02 implementation of approved CP-T5UI1 v1.0. Deployment is disabled by default (FEATURE_DISABLED); missing reference sources fail closed (DEPENDENCY_UNAVAILABLE). X-Organization-Id selects an organization and is checked against authenticated membership. Demand security errors use the module envelope; other core routes retain legacy responses. Cross-team runtime acceptance is separate."
  },
  "servers": [{"url": "/api/v1"}],
  "security": [{"session": []}],
  "paths": {
    "/enterprise/demands": {
      "parameters": [{"$ref": "#/components/parameters/Organization"}],
      "get": {
        "operationId": "listEnterpriseDemands",
        "parameters": [
          {"name":"page","in":"query","schema":{"type":"integer","minimum":0,"maximum":10000,"default":0}},
          {"name":"size","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":25}},
          {"name":"termId","in":"query","schema":{"$ref":"#/components/schemas/Uuid"}},
          {"name":"state","in":"query","schema":{"type":"string","enum":["DRAFT","READY"]}},
          {"name":"includeDeleted","in":"query","schema":{"type":"boolean","default":false}}
        ],
        "responses": {
          "200":{"description":"Own organization page","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemandPage"}}}},
          "default":{"$ref":"#/components/responses/Error"}
        }
      },
      "post": {
        "operationId": "createEnterpriseDemandDraft",
        "parameters": [{"$ref":"#/components/parameters/Idempotency"},{"$ref":"#/components/parameters/Csrf"}],
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemandInput"}}}},
        "responses": {
          "201":{"description":"Draft or original idempotent response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Demand"}}}},
          "default":{"$ref":"#/components/responses/Error"}
        }
      }
    },
    "/enterprise/demands/{id}": {
      "parameters": [{"$ref":"#/components/parameters/Organization"},{"name":"id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/Uuid"}}],
      "patch": {
        "operationId": "updateEnterpriseDemandDraft",
        "parameters": [{"$ref":"#/components/parameters/Idempotency"},{"$ref":"#/components/parameters/Csrf"}],
        "requestBody":{"required":true,"content":{"application/json":{"schema":{
          "type":"object","additionalProperties":false,"required":["expectedVersion","data"],
          "properties":{"expectedVersion":{"$ref":"#/components/schemas/Version"},"data":{"$ref":"#/components/schemas/DemandInput"}}
        }}}},
        "responses": {
          "200":{"description":"Updated draft or original idempotent response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Demand"}}}},
          "default":{"$ref":"#/components/responses/Error"}
        }
      }
    }
  },
  "components": {
    "securitySchemes":{"session":{"type":"apiKey","in":"cookie","name":"SESSION"}},
    "parameters": {
      "Organization":{"name":"X-Organization-Id","in":"header","required":true,"description":"Selected organization, verified against current ENTERPRISE membership and permission on every request.","schema":{"$ref":"#/components/schemas/Uuid"}},
      "Idempotency":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"$ref":"#/components/schemas/Uuid"}},
      "Csrf":{"name":"X-CSRF-TOKEN","in":"header","required":true,"description":"Obtain from /auth/csrf and refresh after login.","schema":{"type":"string"}}
    },
    "responses": {
      "Error":{"description":"400 schema, 401 session, 403 permission/CSRF, 404 foreign/missing demand, 409 conflict/replay/catalog changed, 422 criteria, 500 rollback, 503 feature disabled/reference unavailable. Demand authentication/authorization/CSRF filters use this envelope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DemandError"}}}}
    },
    "schemas": {
      "Uuid":{"type":"string","format":"uuid"},
      "Version":{"type":"integer","minimum":0,"maximum":9007199254740991},
      "Code":{"type":"string","minLength":1,"maxLength":64},
      "DateRange":{
        "type":"object","additionalProperties":false,"required":["startDate","endDate"],
        "properties":{"startDate":{"type":"string","format":"date"},"endDate":{"type":"string","format":"date"}},
        "description":"Inclusive interval; endDate must be on or after startDate."
      },
      "Skill":{
        "type":"object","additionalProperties":false,"required":["skillCode","minLevel","minYearsPractice"],
        "properties":{"skillCode":{"$ref":"#/components/schemas/Code"},"minLevel":{"type":["integer","null"],"minimum":1,"maximum":5},"minYearsPractice":{"type":["number","null"],"minimum":0}}
      },
      "RequiredCriteria":{
        "type":"object","additionalProperties":false,"required":["majorCodes","skills","dateRange"],
        "properties":{"majorCodes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/components/schemas/Code"}},"skills":{"type":"array","items":{"$ref":"#/components/schemas/Skill"}},"dateRange":{"$ref":"#/components/schemas/DateRange"}},
        "description":"Required skills are AND; empty majorCodes imposes no major restriction. Skill codes must be unique across both groups."
      },
      "DemandInput":{
        "type":"object","additionalProperties":false,
        "required":["schoolOrgId","termId","title","quantity","description","location","benefits","deadline","required","preferred","academicCatalogVersion","taxonomyVersion"],
        "properties":{
          "schoolOrgId":{"$ref":"#/components/schemas/Uuid"},"termId":{"$ref":"#/components/schemas/Uuid"},
          "title":{"type":"string","minLength":1,"maxLength":200},"quantity":{"type":"integer","minimum":1,"maximum":5000},
          "description":{"type":"string","minLength":1,"maxLength":10000},"location":{"type":["string","null"],"minLength":1,"maxLength":500},
          "benefits":{"type":["string","null"],"maxLength":2000},"deadline":{"type":"string","format":"date-time"},
          "required":{"$ref":"#/components/schemas/RequiredCriteria"},"preferred":{"type":"array","items":{"$ref":"#/components/schemas/Skill"}},
          "academicCatalogVersion":{"$ref":"#/components/schemas/Code"},"taxonomyVersion":{"$ref":"#/components/schemas/Code"}
        }
      },
      "Demand":{
        "type":"object","additionalProperties":false,
        "required":["demandId","enterpriseOrgId","state","version","criteriaVersion","validationState","data","cooperationId","softDeletedAt"],
        "properties":{
          "demandId":{"$ref":"#/components/schemas/Uuid"},"enterpriseOrgId":{"$ref":"#/components/schemas/Uuid"},"state":{"type":"string","enum":["DRAFT","READY"]},
          "version":{"$ref":"#/components/schemas/Version"},"criteriaVersion":{"$ref":"#/components/schemas/Version"},"validationState":{"type":"string","enum":["VALID"]},
          "data":{"$ref":"#/components/schemas/DemandInput"},"cooperationId":{"type":"null","description":"No Cooperation integration in this slice."},"softDeletedAt":{"type":["string","null"],"format":"date-time"}
        }
      },
      "DemandPage":{
        "type":"object","required":["content","page","size","totalElements","totalPages"],
        "properties":{"content":{"type":"array","items":{"$ref":"#/components/schemas/Demand"}},"page":{"type":"integer"},"size":{"type":"integer"},"totalElements":{"type":"integer"},"totalPages":{"type":"integer"}}
      },
      "DemandError":{
        "type":"object","required":["errorCode","error","message","requestId","fieldErrors","retryAfterSeconds"],
        "properties":{
          "errorCode":{"type":"string"},"error":{"type":"string"},"message":{"type":"string"},"requestId":{"$ref":"#/components/schemas/Uuid"},
          "fieldErrors":{"type":"array","items":{"type":"object","required":["field","code","message"],"properties":{"field":{"type":"string"},"code":{"type":"string"},"message":{"type":"string"}}}},
          "retryAfterSeconds":{"type":["integer","null"]}
        }
      }
    }
  }
}

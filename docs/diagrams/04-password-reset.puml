@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14
skinparam shadowing false
skinparam activity {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
  DiamondBackgroundColor #FFFBEB
  DiamondBorderColor #D97706
}
title UT.Bridora — Quên và đặt lại mật khẩu

|Người dùng|
start
:Nhập email ở màn Quên mật khẩu;
|Frontend|
:Lấy CSRF; POST /api/v1/auth/password/forgot;
|Backend|
if (CSRF hợp lệ?) then (Có)
else (Không)
  :Trả 403;
  stop
endif
if (Email đầu vào hợp lệ?) then (Có)
else (Không)
  :Trả 400;
  stop
endif
|Cơ sở dữ liệu|
:Tìm và khóa tài khoản theo email;
if (Có tài khoản ACTIVE?) then (Có)
  :Trong transaction: vô hiệu token reset cũ;\nlưu hash token PASSWORD_RESET mới, hạn 30 phút;
  |Dịch vụ email|
  :Gửi liên kết đặt lại mật khẩu;
  |Backend|
  if (SMTP thành công?) then (Có)
    |Cơ sở dữ liệu|
    :Commit transaction;
  else (Không)
    |Cơ sở dữ liệu|
    :Rollback transaction;
    |Backend|
    :Bắt MailException; ghi warning\nkhông chứa email/token/payload;
  endif
else (Không)
  :Không tạo token hoặc gửi email;
endif
|Backend|
:Trả cùng một thông báo chung:\nNếu địa chỉ phù hợp, email sẽ được gửi;
|Frontend|
:Hiển thị thông báo chung;
|Người dùng|
if (Có liên kết reset được gửi đến?) then (Có)
  :Mở liên kết; nhập mật khẩu mới;
else (Không)
  :Kiểm tra email hoặc thử lại sau;
  stop
endif
|Frontend|
:Lấy CSRF; POST /api/v1/auth/password/reset;
|Backend|
if (CSRF hợp lệ?) then (Có)
else (Không)
  :Trả 403;
  stop
endif
if (Dữ liệu và chính sách mật khẩu hợp lệ?) then (Có)
else (Không)
  :Trả 400;
  stop
endif
|Cơ sở dữ liệu|
:Bắt đầu transaction; tìm token theo hash/purpose;\nkhóa user trước, rồi khóa token;
|Backend|
if (User ACTIVE; token đúng mục đích,\nchưa dùng và chưa hết hạn?) then (Có)
else (Không)
  :Rollback; trả 400 với lỗi token không hợp lệ;
  stop
endif
|Cơ sở dữ liệu|
:Tiêu thụ token bằng cập nhật có điều kiện;
if (Đúng một token được tiêu thụ?) then (Có)
else (Không)
  :Rollback; từ chối token đã được dùng;
  stop
endif
|Backend|
:Băm mật khẩu mới bằng BCrypt;
|Cơ sở dữ liệu|
:Cập nhật mật khẩu; tăng security_version;\nreset failed_attempts / locked_until;\nvô hiệu các token reset khác;
|Backend|
:Ghi PASSWORD_RESET / SUCCESS\ntrong cùng transaction;
if (Commit thành công?) then (Có)
  :Trả thông báo reset thành công;
  |Frontend|
  :Chuyển đến màn đăng nhập;
  |Người dùng|
  :Đăng nhập bằng mật khẩu mới;
  stop
else (Không)
  |Cơ sở dữ liệu|
  :Rollback mật khẩu, version, token và audit;
  |Frontend|
  :Hiển thị lỗi; không báo reset thành công;
  stop
endif

legend bottom
  Phiên cũ bị từ chối ở request tiếp theo do security_version thay đổi.
  Không giả định xóa ngay mọi bản ghi SPRING_SESSION.
  SMTP đang đồng bộ; outbox/retry và chống enumeration theo timing còn cần hoàn thiện.
  Thông báo chung áp dụng cho email không có account ACTIVE và lỗi MailException;
  lỗi hạ tầng khác vẫn có thể trả 5xx.
endlegend
@enduml

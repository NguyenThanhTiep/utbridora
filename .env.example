# Copy to .env, use unique secrets; never commit .env
DB_URL=jdbc:mysql://localhost:3306/utbridora?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC
DB_USER=bridora
DB_PASSWORD=
DB_ROOT_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Production: set APP_PUBLIC_URL to your HTTPS site URL
APP_PUBLIC_URL=http://localhost:5173

# Disable outside local demos. T5 owns genuine enterprise verification.
ALLOW_DEMO_VERIFICATION=false
COOKIE_SECURE=false
MAIL_HOST=localhost
MAIL_FROM=no-reply@utbridora.local
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
# Staging uses a separate env file with HTTPS, COOKIE_SECURE=true and real SMTP.
STAGING_HTTP_PORT=8088

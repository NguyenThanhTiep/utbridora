# Copy outside Git as .env.staging; fill private values, never commit the filled file.
DB_PASSWORD=
DB_ROOT_PASSWORD=
APP_PUBLIC_URL=https://YOUR_HTTPS_HOST
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
# First initialization only; remove bootstrap values after verifying the new admin.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
STAGING_HTTP_PORT=8088
